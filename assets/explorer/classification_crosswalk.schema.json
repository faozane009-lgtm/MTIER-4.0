{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-TIER External Classification Crosswalk",
  "type": "object",
  "required": [
    "catalog_version",
    "status",
    "generated_on",
    "record_count",
    "records"
  ],
  "properties": {
    "catalog_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "mapping_scaffold_not_imported",
        "mapping_in_progress",
        "reviewed"
      ]
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "occupation_id",
          "links",
          "review"
        ],
        "properties": {
          "occupation_id": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "required": [
              "esco",
              "isco08",
              "onet"
            ],
            "properties": {
              "esco": {
                "$ref": "#/$defs/link"
              },
              "isco08": {
                "$ref": "#/$defs/link"
              },
              "onet": {
                "$ref": "#/$defs/link"
              }
            },
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "required": [
              "review_required",
              "reviewed_by",
              "reviewed_at",
              "notes"
            ],
            "properties": {
              "review_required": {
                "type": "boolean"
              },
              "reviewed_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "concept_uri",
        "match_status",
        "match_method",
        "confidence"
      ],
      "properties": {
        "concept_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_group_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "soc_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "database_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "match_status": {
          "enum": [
            "not_mapped",
            "candidate",
            "confirmed",
            "not_applicable"
          ]
        },
        "match_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "esco_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
