{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-TIER Academy learning path",
  "type": "object",
  "required": [
    "id",
    "title",
    "language",
    "level",
    "status",
    "learning_outcomes",
    "modules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "language": {
      "const": "fr"
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived"
      ]
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0.5
    },
    "learning_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lessons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "objective",
                "activity",
                "assessment"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "objective": {
                  "type": "string"
                },
                "activity": {
                  "type": "string"
                },
                "assessment": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
